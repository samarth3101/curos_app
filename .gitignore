# ============================================================
# Curos Monorepo — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/
.venv/
venv/
.uv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log

# ---- uv ----
# uv.lock files are committed (reproducible builds)
# .python-version is committed (pin Python version)

# ---- Node / pnpm ----
node_modules/
.pnpm-store/
.next/
.turbo/
out/
dist/
*.tsbuildinfo
.vercel/

# ---- Environment ----
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# ---- Docker ----
*.dockerignore

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- IDE / Editors ----
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.orig

# ---- Misc ----
*.tmp
*.bak
*.pid
