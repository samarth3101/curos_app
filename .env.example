# ==============================================================
# Curos Monorepo — Environment Variables Reference
# ==============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================

# ---- Environment ----
ENVIRONMENT=development   # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG           # DEBUG | INFO | WARNING | ERROR

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortex_dev
POSTGRES_USER=cortex
POSTGRES_PASSWORD=changeme

# Full DSN (used by SQLAlchemy and Alembic)
DATABASE_URL=postgresql+asyncpg://cortex:changeme@postgres:5432/cortex_dev

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-strong-random-key-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Cortex OI

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
